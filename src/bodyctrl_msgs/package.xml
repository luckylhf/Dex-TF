<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bodyctrl_msgs</name>
  <version>0.1.0</version>
  <description>
    天工机器人机体控制通信协议接口包：电机状态反馈、位置/速度/电流/力矩控制指令、
    机体 IMU 与电源状态、告警与异常，以及电机标定、运动规划等服务。
    Interface definitions (messages and services) for the Tiangong robot body
    control protocol.
  </description>
  <maintainer email="hongfeng.long@ubtrobot.com">Walker Tienkung Dex Maintainers</maintainer>
  <license>Apache-2.0</license>
  <!--
    注意: 本包描述的是机器人厂商的通信协议规格，用于与机器人本体通信。
    再发布或商用前请确认已获得相应授权，详见仓库根目录的 NOTICE 文件。
  -->
  <url type="website">https://github.com/luckylhf/Dex-TF</url>
  <url type="bugtracker">https://github.com/luckylhf/Dex-TF/issues</url>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <!--
    纯 rosidl 接口包（无 C++ 源码），只需以下依赖：
      std_msgs / geometry_msgs / builtin_interfaces —— 接口中实际使用的类型
    已移除未使用的依赖：rclcpp、rclcpp_components、sensor_msgs、
    yaml_cpp_vendor（详见 CMakeLists.txt 中的说明）。
  -->
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>builtin_interfaces</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <!--
    REP-149 format 3 要求: 所有 *_depend 必须出现在 group_depend /
    member_of_group / export 之前，否则 ament_xmllint 会报错。
  -->
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
